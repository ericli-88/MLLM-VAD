{
  "experiment": "E",
  "target_frame_interval": 10,
  "default_fps": 30.0,
  "fps_tolerance": 0.5,
  "onevision": {
    "enabled": true,
    "model_name": "llava-hf/llava-onevision-qwen2-7b-ov-hf",
    "num_samples": 16,
    "duration_seconds": 10.0,
    "load_in_4bit": false,
    "max_new_tokens": 256
  },
  "memory": {
    "enabled": true,
    "mode": "robust",
    "retrieval": "multimodal",
    "capacity": 500,
    "top_k": 3,
    "stage1_multiplier": 4,
    "min_temporal_gap_frames": 150,
    "duplicate_threshold": 0.985,
    "score_threshold": 0.2,
    "alignment_threshold": 0.45,
    "temporal_stability_threshold": 0.6,
    "overall_reliability_threshold": 0.6,
    "weights": {"visual": 0.45, "caption": 0.2, "summary": 0.35}
  }
}
